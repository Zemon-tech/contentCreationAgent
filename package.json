{
  "name": "aggregrator",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "verify": "npx -y tsx src/mastra/demo/verifyPipeline.ts",
    "verify:registry": "npx -y tsx src/mastra/demo/verifyRegistry.ts",
    "verify:workflow": "npx -y tsx src/mastra/demo/runWorkflowDemo.ts",
    "verify:intelligence": "npx -y tsx src/mastra/demo/verifyIntelligence.ts",
    "verify:phase": "npx -y tsx src/mastra/demo/verifyPhase2and3.ts",
    "radar:auto": "npx -y tsx src/mastra/cron/runScheduledRadar.ts",
    "radar:once": "npx -y tsx src/mastra/cron/runScheduledRadar.ts --once",
    "radar:demo": "npx -y tsx src/mastra/cron/runScheduledRadar.ts --demo --once",
    "leads": "npx -y tsx --env-file=.env src/mastra/cli/leads.ts",
    "verify:leads": "npx -y tsx src/mastra/demo/verifyLeads.ts",
    "verify:x": "npx -y tsx src/mastra/demo/verifyXPublisher.ts",
    "inbox": "npx -y tsx --env-file=.env src/mastra/demo/inboxDropServer.ts",
    "feeds:verify": "npx -y tsx src/mastra/demo/verifyFeeds.ts",
    "sources:verify": "npx -y tsx src/mastra/demo/verifySources.ts",
    "ig:check": "npx -y tsx --env-file=.env src/mastra/demo/igCheck.ts",
    "ingest:dry": "npx -y tsx src/mastra/demo/ingestDryRun.ts",
    "auto:dry": "npx -y tsx --env-file=.env src/mastra/demo/autoNewsDryRun.ts",
    "ras:render:test": "npx -y tsx --env-file=.env src/mastra/demo/rasRenderTest.ts",
    "auto:radar": "npx -y tsx --env-file=.env src/mastra/cron/runAutoNewsRadar.ts",
    "auto:radar:once": "npx -y tsx --env-file=.env src/mastra/cron/runAutoNewsRadar.ts --once",
    "rank:preview": "npx -y tsx src/mastra/demo/rankPreview.ts",
    "rank:seed:feeds": "npx -y tsx src/mastra/demo/seedGoldenFromFeeds.ts",
    "rank:seed": "npx -y tsx --env-file=.env src/mastra/eval/seedFixtures.ts",
    "rank:eval": "npx -y tsx --env-file=.env src/mastra/eval/rankEval.ts",
    "test": "npx -y tsx --test tests/ranking/hardFilter.test.ts tests/ranking/score.test.ts tests/ranking/factPack.test.ts tests/ingestion/paywall.test.ts tests/ingestion/feedImages.test.ts tests/ingestion/feedHealth.test.ts tests/ingestion/robots.test.ts tests/ingestion/canonicalize.test.ts tests/safety/ledger.test.ts tests/image/validate.test.ts tests/ras/handoff.test.ts tests/ras/pick.test.ts tests/ranking/llmScore.test.ts tests/ras/preflight.test.ts tests/instagram/client.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.67.0",
    "@mastra/duckdb": "1.9.0",
    "@mastra/libsql": "1.23.0",
    "@mastra/memory": "1.30.0",
    "@mastra/observability": "1.17.8",
    "@resvg/resvg-js": "^2.6.2",
    "exa-js": "2.23.0",
    "react": "^19.3.0",
    "satori": "^0.44.3",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "mastra": "1.30.0",
    "typescript": "^6.0.3"
  }
}
