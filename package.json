{
  "name": "aggregrator",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "verify": "npx -y tsx src/mastra/demo/verifyPipeline.ts",
    "verify:registry": "npx -y tsx src/mastra/demo/verifyRegistry.ts",
    "verify:workflow": "npx -y tsx src/mastra/demo/runWorkflowDemo.ts",
    "verify:intelligence": "npx -y tsx src/mastra/demo/verifyIntelligence.ts",
    "verify:phase": "npx -y tsx src/mastra/demo/verifyPhase2and3.ts",
    "radar:auto": "npx -y tsx src/mastra/cron/runScheduledRadar.ts",
    "radar:once": "npx -y tsx src/mastra/cron/runScheduledRadar.ts --once",
    "radar:demo": "npx -y tsx src/mastra/cron/runScheduledRadar.ts --demo --once",
    "leads": "npx -y tsx --env-file=.env src/mastra/cli/leads.ts",
    "verify:leads": "npx -y tsx src/mastra/demo/verifyLeads.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.67.0",
    "@mastra/duckdb": "1.9.0",
    "@mastra/libsql": "1.23.0",
    "@mastra/memory": "1.30.0",
    "@mastra/observability": "1.17.8",
    "exa-js": "2.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.30.0",
    "typescript": "^6.0.3"
  }
}
