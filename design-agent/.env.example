# Copy to .env and fill in. See spec.md section 10.
# .env is git-ignored; never commit real secrets.

# --- runtime / observability ---
ENVIRONMENT=development           # development | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_RENDERER=console            # console | json  (defaults by environment)

# --- auth (required) ---
DESIGN_AGENT_API_KEY=change-me    # value clients send in the X-API-Key header

# --- Sarvam (LLM) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b

# --- ComfyUI ---
COMFYUI_BASE_URL=http://192.168.1.144:8188
COMFYUI_TIMEOUT_S=300

# --- filesystem ---
OUTPUT_DIR=./output
TEMPLATES_DIR=./templates
BRAND_FILE=./brand.yaml

# --- concurrency ---
RENDER_CONCURRENCY=2
JOB_WORKERS=1
