<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ text.headline | default("The Entrepreneur Post") }}</title>
  {% if style_content %}
  <style>
    {{ style_content | safe }}
  </style>
  {% else %}
  <link rel="stylesheet" href="style.css">
  {% endif %}
  {% if css_colors %}
  <style>
    :root {
      {% for prop, val in css_colors.items() %}
      {{ prop }}: {{ val }};
      {% endfor %}
    }
  </style>
  {% endif %}
</head>
<body>
  <div id="canvas" class="aspect-{{ (aspect_ratio | default('4:5')).replace(':', '-') }}" style="width: {{ width | default(1080) }}px; height: {{ height | default(1350) }}px;">
    <div class="safe-zone">
      <!-- Publication Masthead Header -->
      <header class="publication-header">
        <h1 class="masthead-title">{{ publication_name | default("The Entrepreneur Post") }}</h1>
        <div class="nav-divider"></div>
        <nav class="nav-bar">
          <span class="nav-link">Home</span>
          <span class="nav-link">About</span>
        </nav>
        <div class="nav-divider"></div>
      </header>

      <!-- Main Editorial Content Area -->
      <main class="editorial-content">
        <!-- Breadcrumbs bar -->
        <div class="breadcrumb-bar">
          <div class="breadcrumbs">
            <span>Home</span>
            <span class="breadcrumb-separator">&gt;</span>
            <span>Posts</span>
            <span class="breadcrumb-separator">&gt;</span>
            <span class="breadcrumb-active">{% if text and text.eyebrow %}{{ text.eyebrow }}{% elif text and text.headline %}{{ text.headline }}{% endif %}</span>
          </div>
          {% if total_slides and total_slides > 1 %}
          <div class="slide-indicator">
            {{ "%02d" | format((slide_index | default(0)) + 1) }} / {{ "%02d" | format(total_slides) }}
          </div>
          {% endif %}
        </div>

        <!-- Article Headline -->
        {% if text and text.headline %}
        <h2 class="slot-headline" data-slot="headline">{{ text.headline }}</h2>
        {% endif %}

        <!-- Article Excerpt / Body -->
        {% if text and text.body %}
        <p class="slot-body" data-slot="body">{{ text.body }}</p>
        {% endif %}

        <!-- Metadata row (Date & Read Time) -->
        <div class="meta-row">
          <div class="meta-item">
            <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>{{ post_date | default("Jun 24, 2026") }}</span>
          </div>
          <div class="meta-item">
            <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{{ read_time | default("4 min read") }}</span>
          </div>
        </div>

        <!-- Featured Article Image (Always templates/shared.jpg) -->
        <div class="article-image-wrapper">
          <img class="article-image" src="{{ shared_image or 'data:image/jpeg;base64,' }}" alt="Featured article image" />
        </div>

        <!-- Call to Action -->
        <div class="slot-cta" data-slot="cta">
          {{ (text and text.cta) or "Read full article from link in bio." }}
        </div>
      </main>

      <!-- Footer Brand Slug -->
      <footer class="editorial-footer">
        <div class="brand-slug">[{{ brand_slug | default(brand_name) | default("360Labs") }}]</div>
      </footer>
    </div>
  </div>
</body>
</html>
