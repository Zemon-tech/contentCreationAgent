OPENAI_API_KEY=

# Local OpenAI-compatible model. TWO OPTIONS (pick one):
#
# Option A — local vLLM server:
#   LOCAL_MODEL_BASE_URL=http://localhost:8000/v1
#   LOCAL_MODEL_NAME=<served model id from GET /v1/models>
#   LOCAL_MODEL_API_KEY=<only if your server requires one; else omit>
#
# Option B — Sarvam API (https://dashboard.sarvam.ai, OpenAI-compatible):
#   LOCAL_MODEL_BASE_URL=https://api.sarvam.ai/v1
#   LOCAL_MODEL_NAME=sarvam-30b        (or sarvam-105b for the larger model)
#   LOCAL_MODEL_API_KEY=<your Sarvam subscription key>
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=
LOCAL_MODEL_API_KEY=
# SARVAM_API_KEY=   (alternative to LOCAL_MODEL_API_KEY for Sarvam)

# Exa web search + scrape (https://dashboard.exa.ai/api-keys)
EXA_API_KEY=

# ---------------------------------------------------------------------------
# Instagram publishing (Instagram Graph API / Meta)
# ---------------------------------------------------------------------------
# Requires an Instagram PROFESSIONAL account (Business or Creator) linked to a
# Facebook Page, and a long-lived access token with these permissions:
#   instagram_basic, instagram_content_publish, pages_read_engagement
# Get the IG user id + token via Meta App Dashboard / Graph API Explorer:
#   https://developers.facebook.com/docs/instagram-platform/content-publishing
#
# INSTAGRAM_ACCOUNT_ID: the numeric IG User id (NOT your @handle).
INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_ACCESS_TOKEN: long-lived token with content-publishing permission.
INSTAGRAM_ACCESS_TOKEN=
# Graph API version (optional). Bump when Meta deprecates the default.
INSTAGRAM_GRAPH_VERSION=v23.0
# Which API host. Default (unset) = graph.facebook.com (Facebook-login tokens, needs a linked Page).
# For "API setup with Instagram login" (token generated in the Meta dashboard, no Page) use:
# INSTAGRAM_GRAPH_HOST=https://graph.instagram.com
INSTAGRAM_GRAPH_HOST=
# Safety switch: when true, publish tools validate + log but never post.
INSTAGRAM_DRY_RUN=true

# Public origin a BROWSER uses to reach the Mastra server (port 4111).
# Inline image URLs for rendered RAS posts / Flux output are baked with this
# prefix and pasted into chat as <img> tags. Leave it unset for local dev
# (defaults to http://localhost:4111). On a DEPLOYED host it MUST be the
# externally reachable origin — otherwise chat renders localhost URLs that
# only load on the server itself, and posts appear broken for everyone else.
# With a cloudflared tunnel to your domain, set it to that domain, e.g.
# MASTRA_PUBLIC_URL=https://ras.yourdomain.com
MASTRA_PUBLIC_URL=

# Public base URL that serves the /post-assets route to the internet.
# Instagram fetches slide images from these URLs, so they MUST be public HTTPS.
# In production set your deployed host; in local dev use a tunnel (ngrok /
# cloudflared) that forwards to the Mastra server, e.g. https://<id>.ngrok.app
PUBLIC_BASE_URL=
# Port of `npm run publish:serve` (the read-only JPEG server you tunnel to the internet, NOT 4111).
PUBLISH_PROXY_PORT=4112
# Canonical root for rendered RAS output. Set this so the renderer, the Mastra
# server (4111) and the publish:serve proxy (4112) all resolve the SAME folder;
# otherwise they guess from cwd/module path and can disagree, making Instagram
# fetch a 404. Point it at wherever the renderer writes, e.g.
# <repo>/src/mastra/public/workspace/output
RAS_OUTPUT_ROOT=

# ---------------------------------------------------------------------------
# ICP lead research workflow (lead-qualification-workflow)
# ---------------------------------------------------------------------------
# Separate keys: this pipeline NEVER reads EXA_API_KEY / SARVAM_API_KEY.
# Required keys have no defaults; the workflow refuses to start without them.

# Exa Agent API key (https://dashboard.exa.ai/api-keys). Tip: give this key
# its own spending budget in the Exa dashboard as a second safety net.
LEAD_EXA_API_KEY=
# Sarvam subscription key (https://dashboard.sarvam.ai) for the ICP judge.
LEAD_SARVAM_API_KEY=

# Lead data store (contains personal contact data). Relative file: paths are
# resolved against the project root, never against .mastra/output.
LEAD_DATABASE_URL=file:./leads.db
LEAD_DATABASE_AUTH_TOKEN=
# Batch exports: <LEAD_EXPORT_DIR>/<batchId>/companies.csv, team.csv, ...
LEAD_EXPORT_DIR=./workspace/leads
# Optional: csvPath inputs must live inside this folder (default: project root).
LEAD_INPUT_DIR=

# Cost + speed controls (REQUIRED, PRD §11 / OPEN-3 — values below are
# starting points for Phase 0, not owner-approved numbers).
LEAD_EXA_MAX_CONCURRENT_RUNS=40
LEAD_COMPANY_CONCURRENCY=5
LEAD_MAX_TEAM_CONTACTS_PER_COMPANY=20
LEAD_MAX_COST_PER_COMPANY_USD=8
LEAD_MAX_COST_PER_BATCH_USD=100
# budget.maxCostDollars for auto-effort modules (Exa accepts 1-100).
LEAD_M1_BUDGET_USD=2
LEAD_M5_BUDGET_USD=1

# Tuning (optional — defaults shown).
LEAD_SARVAM_MODEL=sarvam/sarvam-105b
# Reasoning tokens share the completion budget, so keep max_tokens high and
# reasoning off (the ICP judge does not need chain-of-thought). Raise effort
# to low/medium only if verdict quality needs it, and raise max_tokens too.
LEAD_SARVAM_MAX_TOKENS=16384
LEAD_SARVAM_REASONING_EFFORT=none
LEAD_EXA_POLL_INTERVAL_MS=4000
LEAD_MODULE_TIMEOUT_MS=600000
LEAD_EXA_MAX_CREATE_ATTEMPTS=5
LEAD_EXA_BACKOFF_BASE_MS=2000
LEAD_EXA_MAX_STARTS_PER_SECOND=4
LEAD_TEAM_CHUNK_SIZE=10
LEAD_EXA_EMAIL_RATE_USD=0.02
LEAD_EXA_PHONE_RATE_USD=0.07

# M6 social activity (company + founders on LinkedIn / X / Instagram).
# Runs through Exa Agent; no extra API key. LEAD_M6_DATA_SOURCES attaches Exa
# Connect providers (fiber = Fiber.ai LinkedIn data, billed per credit by Exa);
# set to "none" for Exa web search only.
LEAD_M6_ENABLED=true
LEAD_M6_DATA_SOURCES=fiber
# budget.maxCostDollars for the M6 run (Exa accepts 1-100).
LEAD_M6_BUDGET_USD=1
# Worst-case reserve for Connect provider charges, which Exa bills on top.
LEAD_M6_CONNECT_RESERVE_USD=1
# Founders/leaders checked per company (founders first).
LEAD_M6_MAX_PEOPLE=5

# Local ComfyUI (Flux.2 Dev image generation — imageGenAgent / flux-tools).
# The URL of your locally deployed ComfyUI server. Start ComfyUI with
# `--listen` if it is on another host. Defaults to http://127.0.0.1:8188.
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Optional bearer token, only if you put ComfyUI behind an authenticated proxy.
COMFYUI_API_KEY=
# Where pasted/dropped reference images land before being shipped to ComfyUI.
# Defaults to workspace/flux/inbox. The `npm run inbox` paste page and the
# useInboxReferences tool both use this path — keep them in sync.
FLUX_INBOX_DIR=

# ---------------------------------------------------------------------------
# News ranker (rankStories — Stage 3). All optional; defaults live in
# src/mastra/config/ranking.config.ts. These envs only override them.
# ---------------------------------------------------------------------------
# Stage B scoring model. If BOTH are set, the ranker uses this dedicated
# (cheaper) OpenAI-compatible endpoint; otherwise it falls back to the
# project's small model (resolveSmallChatModel()).
RANK_MODEL_BASE_URL=
RANK_MODEL_NAME=
RANK_MODEL_API_KEY=

# Stage A hard filters
RANK_MAX_AGE_HOURS=6            # drop items older than this
RANK_REJECTED_WITHIN_HOURS=168  # "already rejected" counts for this many hours
RANK_MIN_SUMMARY_LENGTH=40      # drop summaries shorter than this (chars)

# Stage B scoring
RANK_BATCH_SIZE=1               # items per LLM call (1 is robust for Sarvam; raise for a cheaper model)
RANK_CONCURRENCY=4                # model calls in flight at once (~3.6x faster than 1; lower if you see 429s)
RANK_CACHE_ENABLED=true          # scheduled workflow re-uses scores for articles seen in a recent cycle (rank:eval never does)
RANK_CACHE_TTL_HOURS=24
RANK_CACHE_VERSION=1             # bump after editing the prompt/few-shots to invalidate cached scores
RANK_TEMPERATURE=0.15           # keep low for stable scoring
RANK_MAX_OUTPUT_TOKENS=16384    # big budget: Sarvam spends ~2k reasoning tokens/item on top of the JSON
RANK_COST_PER_1K_TOKENS_USD=0   # for the cost estimate (0 = free local model)

# Stage C deterministic score
RANK_RECENCY_HALFLIFE_HOURS=3
RANK_COVERAGE_CAP=5             # clusterSourceCount at which coverage saturates
RANK_DEFAULT_SOURCE_CREDIBILITY=3
RANK_REGION_LOOKBACK=3          # recent posts inspected for US/IN balance
RANK_REGION_BOOST=3             # points added to the under-represented region

# Penalties (final-score points subtracted)
RANK_PENALTY_OPINION_RUMOR=25
RANK_PENALTY_CLICKBAIT=20
RANK_PENALTY_DUPLICATE=15
RANK_PENALTY_UNSCORED=30

# Stage D selection
RANK_TOP_N=1                    # how many stories to select per run
RANK_MIN_SCORE=55               # minimum final score to be selectable (0-100)

# ---------------------------------------------------------------------------
# Feed ingestion hygiene (config/ingestion.config.ts). All optional.
# ---------------------------------------------------------------------------
INGEST_USER_AGENT=              # honest bot UA sent on every request (has a sane default)
FEED_FETCH_TIMEOUT_MS=15000
FEED_CONDITIONAL_GET=true       # send ETag / If-Modified-Since; 304 = success
FEED_PER_DOMAIN_MIN_INTERVAL_MS=2000  # min gap between requests to one domain

# robots.txt policy
FEED_ROBOTS_ENABLED=true
FEED_ROBOTS_FEED_FAIL_OPEN=true        # feeds: allow if robots is unreachable/5xx
FEED_ROBOTS_SCRAPER_FAIL_CLOSED=true   # scraper: refuse if robots unreachable/5xx (404 = allowed)
FEED_ROBOTS_CACHE_TTL_MS=21600000

# feed-health auto-disable / re-probe
FEED_AUTO_DISABLE_AFTER=5       # consecutive failures before auto-disable
FEED_REPROBE_HOURS=24           # re-probe an auto-disabled source after this long
FEED_STALE_DAYS=7               # newest item older than this => stale WARNING (not a failure)

# paywalled article domains (comma list) added to the built-in set (wsj.com, ft.com, …)
FEED_PAYWALLED_DOMAINS=

# Google News fallback (headline-level discovery for dropped/auto-disabled feeds)
# Default OFF: news.google.com disallows generic bots in robots.txt, so with
# robots respected the fallback endpoint is blocked anyway.
GOOGLE_NEWS_FALLBACK_ENABLED=false
GOOGLE_NEWS_MAX_ITEMS=10        # cap per fallback query per run
GOOGLE_NEWS_WHEN=1d             # recency window token

# ---------------------------------------------------------------------------
# Auto news -> RAS pipeline (autoNewsToRasWorkflow). Safety-first defaults.
# ---------------------------------------------------------------------------
# NOTHING publishes unless BOTH of these are flipped AND approval is granted.
INSTAGRAM_DRY_RUN=true          # true = never publish (also gates the IG client)
REQUIRE_APPROVAL=true           # true = suspend for approval before publishing
AUTO_INTERVAL_MINUTES=30        # scheduled cadence for runAutoNewsRadar
# How many top-ranked stories to post as SEPARATE posts in one run (rank 1,2,3…).
# 1 (default) = single post, unchanged behavior. >1 posts the top N to BOTH
# Instagram and X in the same run; the batch counts as one unit against
# POST_MAX_PER_DAY and bypasses POST_MIN_GAP_HOURS between posts WITHIN the
# batch. Each post is independent — one failing never aborts the others.
MAX_POSTS_PER_RUN=1
# Also post the SAME rendered graphic to X (Twitter) on the live+approved path,
# with a standalone <=280-char tweet (NOT a truncated IG caption). X is fully
# independent and fail-soft: a missing/not-logged-in X session or an X failure
# is reported but NEVER fails the Instagram post or the run. X obeys the SAME
# INSTAGRAM_DRY_RUN safety switch (no separate dry-run) and needs a logged-in
# tweetytweets browser session (PYTHON_PATH optional, defaults to `python`).
X_POST_ENABLED=true             # false = never attempt X (Instagram unchanged)

# Posting rate caps (last safety gate before publish)
POST_MAX_PER_DAY=4
POST_MIN_GAP_HOURS=3
POST_MIN_SCORE=                 # defaults to RANK_MIN_SCORE if unset
POST_BLOCK_REJECTED_HOURS=      # defaults to RANK_REJECTED_WITHIN_HOURS if unset

# ---------------------------------------------------------------------------
# Editorial copywriter (lib/ras/copywriter.ts). LLM-written post copy
# (serifHeadline / deck lines / caption) that replaces the old template copy.
# Defaults live in src/mastra/config/copy.config.ts; these only override them.
# The copywriter reuses the SAME Sarvam ranker model and ENRICHES with Exa web
# search (free third-party coverage of the same story — never the paywalled
# body). If the model errors or Exa is unavailable it FALLS BACK to the
# deterministic template; a run never fails because of copy.
# ---------------------------------------------------------------------------
COPY_LLM_ENABLED=true           # false = always use the deterministic template (old behavior)
COPY_EXA_ENABLED=true           # Exa enrichment on/off (needs EXA_API_KEY; fails open if missing)
COPY_EXA_NUM_RESULTS=5          # third-party coverage results pulled for grounding
COPY_TEMPERATURE=0.4            # a touch above the ranker's 0.15 — creative writing, but still grounded
COPY_MAX_OUTPUT_TOKENS=16384    # big budget: Sarvam burns ~2k reasoning tokens/call before the JSON (same as the ranker)
COPY_CAPTION_MAX_SENTENCES=6    # soft target for caption length

# Image sourcing + local storage (RAS composites the local file into its PNG;
# IMAGE_DIR does NOT need to be publicly served).
IMAGE_DIR=                      # default ./data/images (add to a persistent disk)
IMAGE_RETENTION_DAYS=7
IMAGE_MAX_BYTES=10485760        # 10 MB download cap
IMAGE_DOWNLOAD_TIMEOUT_MS=15000
IMAGE_MIN_SHORT_SIDE=1080       # under this is allowed but flagged
IMAGE_MIN_ANY_SIDE=400          # logo/tiny guard
IMAGE_EXA_CANDIDATES=5          # Exa image-search candidates (needs EXA_API_KEY)
